{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=BuylyDb;User=root;Password=your_password;"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_JWT_SECRET_KEY",
    "Issuer": "BuylyAPI",
    "Audience": "BuylyAPIUsers",
    "ExpirationMinutes": 60
  },
  "PayPal": {
    "ClientId": "YOUR_PAYPAL_CLIENT_ID",
    "ClientSecret": "YOUR_PAYPAL_CLIENT_SECRET",
    "Environment": "Sandbox"
  },
  "RateLimiting": {
    "GlobalLimit": {
      "PermitLimit": 200,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "StrictLimit": {
      "PermitLimit": 20,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderEmail": "support@example.com",
    "SenderName": "Buyly Support",
    "Username": "support@example.com",
    "Password": "YOUR_SMTP_PASSWORD"
  },
  "ResetPasswordSettings": {
    "CooldownSeconds": 60,
    "WindowMinutes": 60,
    "WindowLimit": 5
  },
  "CleanupSettings": {
    "ExecutionIntervalMinutes": 60,
    "PendingOrderMaxAgeHours": 24,
    "RestoredCartMaxAgeHours": 48
  }
}
